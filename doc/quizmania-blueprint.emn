<?xml version="1.0" encoding="UTF-8"?>
<emn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:emn="https://holixon.io/spec/EMN/20241231/MODEL" xmlns:emndi="https://holixon.io/spec/EMN/20241231/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:emnic="https://holixon.io/spec/EMN/20241231/IC" id="simple" name="Simple" targetNamespace="https://holixon.io/schema/emn" xsi:schemaLocation="https://holixon.io/spec/EMN/20241231/MODEL ../../../../emn-moddle/resources/emn/xsd/EMN.xsd">
  <emn:types>
    <emn:schemaDefinition id="GameId" name="GameId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameQuestionId" name="GameQuestionId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameQuestionId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerId" name="GamePlayerId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameRoundId" name="GameRoundId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameRoundId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameConfig" name="GameConfig">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameConfig",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "maxPlayers": {
        "type": "integer"
        },
        "questionSetId": {
        "type": "string"
        }
        },
        "required": [
        "questionSetId"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="Round" name="Round">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "Round",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "name": {
        "type": "string"
        },
        "roundConfig": {
        "$ref": "RoundConfig"
        },
        "questions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "name",
        "roundConfig",
        "questions"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="RoundConfig" name="RoundConfig">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "RoundConfig",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "useBuzzer": {
        "type": "boolean"
        },
        "secondsToAnswer": {
        "type": "integer",
        "format": "int64"
        }
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameQuestionMode" name="GameQuestionMode">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameQuestionMode",
        "type": "string",
        "enum": [
        "COLLECTIVE",
        "BUZZER"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameStatus" name="GameStatus">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameStatus",
        "type": "string",
        "enum": [
        "CREATED",
        "STARTED",
        "ENDED",
        "CANCELED"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionType" name="QuestionType">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionType",
        "type": "string",
        "enum": [
        "CHOICE",
        "MULTIPLE_CHOICE",
        "FREE_INPUT",
        "ESTIMATE",
        "SORT"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionBase" name="QuestionBase">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionBase",
        "type": "object",
        "properties": {
        "type": {
        "$ref": "QuestionType"
        },
        "id": {
        "type": "string"
        },
        "phrase": {
        "type": "string"
        },
        "imagePath": {
        "type": [
        "string",
        "null"
        ]
        },
        "answerImagePath": {
        "type": [
        "string",
        "null"
        ]
        },
        "correctAnswer": {
        "type": "string"
        }
        },
        "required": [
        "type",
        "id",
        "phrase",
        "correctAnswer"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="ChoiceQuestion" name="ChoiceQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ChoiceQuestion",
        "allOf": [
        {
        "$ref": "QuestionBase"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "CHOICE"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="MultipleChoiceQuestion" name="MultipleChoiceQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "MultipleChoiceQuestion",
        "allOf": [
        {
        "$ref": "QuestionBase"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "MULTIPLE_CHOICE"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="FreeInputQuestion" name="FreeInputQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "FreeInputQuestion",
        "allOf": [
        {
        "$ref": "QuestionBase"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "FREE_INPUT"
        }
        }
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="EstimateQuestion" name="EstimateQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "EstimateQuestion",
        "allOf": [
        {
        "$ref": "QuestionBase"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "ESTIMATE"
        }
        }
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="SortQuestion" name="SortQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "SortQuestion",
        "allOf": [
        {
        "$ref": "QuestionBase"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "SORT"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="Question" name="Question">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "Question",
        "oneOf": [
        {
        "$ref": "ChoiceQuestion"
        },
        {
        "$ref": "MultipleChoiceQuestion"
        },
        {
        "$ref": "FreeInputQuestion"
        },
        {
        "$ref": "EstimateQuestion"
        },
        {
        "$ref": "SortQuestion"
        }
        ],
        "discriminator": {
        "propertyName": "type"
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerScores" name="GamePlayerScores">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerScores",
        "type": "object",
        "additionalProperties": {
        "type": "integer"
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerDto" name="GamePlayerDto">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerDto",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "id": {
        "$ref": "GamePlayerId"
        },
        "name": {
        "type": "string"
        }
        },
        "required": [
        "id",
        "name"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameDto" name="GameDto">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameDto",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "name": {
        "type": "string"
        },
        "maxPlayers": {
        "type": "integer"
        },
        "numQuestions": {
        "type": "integer"
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        },
        "status": {
        "$ref": "GameStatus"
        },
        "players": {
        "type": "array",
        "items": {
        "$ref": "GamePlayerDto"
        }
        }
        },
        "required": [
        "gameId",
        "name",
        "maxPlayers",
        "numQuestions",
        "creator",
        "moderator",
        "status",
        "players"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:commandType id="CommandType_CreateGameCommand" name="CreateGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CreateGameCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "name": {
        "type": "string"
        },
        "config": {
        "$ref": "GameConfig"
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        }
        },
        "required": [
        "gameId",
        "name",
        "config",
        "creator",
        "moderator"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_JoinGameCommand" name="JoinGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "JoinGameCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "username": {
        "type": "string"
        }
        },
        "required": [
        "gameId",
        "username"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_LeaveGameCommand" name="LeaveGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "LeaveGameCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "username": {
        "type": "string"
        }
        },
        "required": [
        "gameId",
        "username"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_StartGameCommand" name="StartGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "StartGameCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_StartNextRoundCommand" name="StartNextRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "StartNextRoundCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_ScoreRoundCommand" name="ScoreRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ScoreRoundCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_CloseRoundCommand" name="CloseRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CloseRoundCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_AnswerQuestionCommand" name="AnswerQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AnswerQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "username": {
        "type": "string"
        },
        "answer": {
        "type": "string"
        },
        "answerTimestamp": {
        "type": "string",
        "format": "date-time"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId",
        "username",
        "answer",
        "answerTimestamp"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_OverrideAnswerCommand" name="OverrideAnswerCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "OverrideAnswerCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "gamePlayerId": {
        "$ref": "GamePlayerId"
        },
        "answer": {
        "type": "string"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId",
        "gamePlayerId",
        "answer"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_BuzzQuestionCommand" name="BuzzQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "BuzzQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "username": {
        "type": "string"
        },
        "buzzerTimestamp": {
        "type": "string",
        "format": "date-time"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId",
        "username",
        "buzzerTimestamp"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_AnswerBuzzerQuestionCommand" name="AnswerBuzzerQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AnswerBuzzerQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "answerCorrect": {
        "type": "boolean"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId",
        "answerCorrect"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_AskNextQuestionCommand" name="AskNextQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AskNextQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_CloseQuestionCommand" name="CloseQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CloseQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CommandType_ScoreQuestionCommand" name="ScoreQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ScoreQuestionCommand",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameId",
        "gameQuestionId"
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:eventType id="EventType_GameCreatedEvent" name="GameCreatedEvent">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="rounds" comment="Derived from questionSet" />
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameCreatedEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "name": {
        "type": "string"
        },
        "config": {
        "$ref": "GameConfig"
        },
        "rounds": {
        "type": "array",
        "items": {
        "$ref": "Round"
        }
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        }
        },
        "required": [
        "gameId",
        "name",
        "config",
        "rounds",
        "creator",
        "moderator"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_PlayerJoinedGameEvent" name="PlayerJoinedGameEvent">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="gamePlayerId" comment="" />
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "PlayerJoinedGameEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gamePlayerId": {
        "$ref": "GamePlayerId"
        },
        "username": {
        "type": "string"
        }
        },
        "required": [
        "gameId",
        "gamePlayerId",
        "username"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_PlayerLeftGameEvent" name="PlayerLeftGameEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "PlayerLeftGameEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gamePlayerId": {
        "$ref": "GamePlayerId"
        },
        "username": {
        "type": "string"
        }
        },
        "required": [
        "gameId",
        "gamePlayerId",
        "username"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_GameStartedEvent" name="GameStartedEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameStartedEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_GameEndedEvent" name="GameEndedEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameEndedEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_GameCanceledEvent" name="GameCanceledEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameCanceledEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_RoundStartedEvent" name="RoundStartedEvent">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="gameRoundId" comment="" />
            <emnic:ignoredProperty name="roundNumber" comment="" />
            <emnic:ignoredProperty name="roundConfig" comment="" />
            <emnic:ignoredProperty name="questions" comment="" />
            <emnic:ignoredProperty name="roundName" comment="" />
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "RoundStartedEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameRoundId": {
        "$ref": "GameRoundId"
        },
        "roundNumber": {
        "type": "integer"
        },
        "roundName": {
        "type": "string"
        },
        "roundConfig": {
        "$ref": "RoundConfig"
        },
        "questions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "gameId",
        "gameRoundId",
        "roundNumber",
        "roundName",
        "roundConfig",
        "questions"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_RoundScoredEvent" name="RoundScoredEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "RoundScoredEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameRoundId": {
        "$ref": "GameRoundId"
        }
        },
        "required": [
        "gameId",
        "gameRoundId"
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="EventType_RoundClosedEvent" name="RoundClosedEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "RoundClosedEvent",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "gameId": {
        "$ref": "GameId"
        },
        "gameRoundId": {
        "$ref": "GameRoundId"
        }
        },
        "required": [
        "gameId",
        "gameRoundId"
        ]
