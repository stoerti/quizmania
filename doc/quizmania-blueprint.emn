<?xml version="1.0" encoding="UTF-8"?>
<emn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:emn="https://holixon.io/spec/EMN/20241231/MODEL" xmlns:emndi="https://holixon.io/spec/EMN/20241231/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:emnic="https://holixon.io/spec/EMN/20241231/IC" id="simple" name="Simple" targetNamespace="https://holixon.io/schema/emn" xsi:schemaLocation="https://holixon.io/spec/EMN/20241231/MODEL ../../../../emn-moddle/resources/emn/xsd/EMN.xsd">
  <emn:types>
    <emn:schemaDefinition id="GameId" name="GameId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameQuestionId" name="GameQuestionId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameQuestionId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerId" name="GamePlayerId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameRoundId" name="GameRoundId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameRoundId",
        "type": "string",
        "format": "uuid"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionId" name="QuestionId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionId",
        "type": "string"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionSetId" name="QuestionSetId">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionSetId",
        "type": "string"
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameConfig" name="GameConfig">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameConfig",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "maxPlayers": {
        "type": "integer",
        "format": "int32",
        "default": 10
        },
        "questionSetId": {
        "$ref": "QuestionSetId"
        }
        },
        "required": [
        "questionSetId"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="Round" name="Round">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "Round",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "name": {
        "type": "string"
        },
        "roundConfig": {
        "$ref": "RoundConfig"
        },
        "questions": {
        "type": "array",
        "items": {
        "$ref": "QuestionId"
        }
        }
        },
        "required": [
        "name",
        "roundConfig",
        "questions"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionSet" name="QuestionSet">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionSet",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "id": {
        "$ref": "QuestionSetId"
        },
        "name": {
        "type": "string"
        },
        "rounds": {
        "type": "array",
        "items": {
        "$ref": "Round"
        }
        }
        },
        "required": [
        "id",
        "name",
        "rounds"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="RoundConfig" name="RoundConfig">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "RoundConfig",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "useBuzzer": {
        "type": "boolean",
        "default": false
        },
        "secondsToAnswer": {
        "type": "integer",
        "format": "int64",
        "default": 30
        }
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameQuestionMode" name="GameQuestionMode">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameQuestionMode",
        "type": "string",
        "enum": [
        "COLLECTIVE",
        "BUZZER"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameStatus" name="GameStatus">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameStatus",
        "type": "string",
        "enum": [
        "CREATED",
        "STARTED",
        "ENDED",
        "CANCELED"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="QuestionType" name="QuestionType">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "QuestionType",
        "type": "string",
        "enum": [
        "CHOICE",
        "MULTIPLE_CHOICE",
        "FREE_INPUT",
        "ESTIMATE",
        "SORT"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="Question" name="Question">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "Question",
        "type": "object",
        "properties": {
        "type": {
        "$ref": "QuestionType"
        },
        "id": {
        "type": "string"
        },
        "phrase": {
        "type": "string"
        },
        "imagePath": {
        "type": [
        "string",
        "null"
        ],
        "default": null
        },
        "answerImagePath": {
        "type": [
        "string",
        "null"
        ],
        "default": null
        },
        "correctAnswer": {
        "type": "string"
        }
        },
        "required": [
        "type",
        "id",
        "phrase",
        "correctAnswer"
        ],
        "discriminator": {
        "propertyName": "type",
        "mapping": {
        "CHOICE": "ChoiceQuestion",
        "MULTIPLE_CHOICE": "MultipleChoiceQuestion",
        "FREE_INPUT": "FreeInputQuestion",
        "ESTIMATE": "EstimateQuestion",
        "SORT": "SortQuestion"
        }
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="ChoiceQuestion" name="ChoiceQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ChoiceQuestion",
        "allOf": [
        {
        "$ref": "Question"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "CHOICE"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="MultipleChoiceQuestion" name="MultipleChoiceQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "MultipleChoiceQuestion",
        "allOf": [
        {
        "$ref": "Question"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "MULTIPLE_CHOICE"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="FreeInputQuestion" name="FreeInputQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "FreeInputQuestion",
        "allOf": [
        {
        "$ref": "Question"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "FREE_INPUT"
        }
        }
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="EstimateQuestion" name="EstimateQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "EstimateQuestion",
        "allOf": [
        {
        "$ref": "Question"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "ESTIMATE"
        }
        }
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="SortQuestion" name="SortQuestion">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "SortQuestion",
        "allOf": [
        {
        "$ref": "Question"
        },
        {
        "type": "object",
        "properties": {
        "type": {
        "const": "SORT"
        },
        "answerOptions": {
        "type": "array",
        "items": {
        "type": "string"
        }
        }
        },
        "required": [
        "answerOptions"
        ]
        }
        ],
        "unevaluatedProperties": false
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerScores" name="GamePlayerScores">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerScores",
        "type": "object",
        "propertyNames": {
        "$ref": "GamePlayerId"
        },
        "additionalProperties": {
        "type": "integer",
        "format": "int32"
        }
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GamePlayerDto" name="GamePlayerDto">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GamePlayerDto",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "id": {
        "$ref": "GamePlayerId"
        },
        "name": {
        "type": "string"
        }
        },
        "required": [
        "id",
        "name"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameDto" name="GameDto">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameDto",
        "type": "object",
        "additionalProperties": false,
        "properties": {
        "id": {
        "$ref": "GameId"
        },
        "name": {
        "type": "string"
        },
        "maxPlayers": {
        "type": "integer",
        "format": "int32"
        },
        "numQuestions": {
        "type": "integer",
        "format": "int32"
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        },
        "status": {
        "$ref": "GameStatus"
        },
        "players": {
        "type": "array",
        "items": {
        "$ref": "GamePlayerDto"
        }
        }
        },
        "required": [
        "id",
        "name",
        "maxPlayers",
        "numQuestions",
        "creator",
        "moderator",
        "status",
        "players"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameCommand" name="GameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameCommand",
        "type": "object",
        "properties": {
        "gameId": {
        "$ref": "GameId",
        "x-emn-role": "entity-id"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameEvent" name="GameEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameEvent",
        "type": "object",
        "properties": {
        "gameId": {
        "$ref": "GameId",
        "x-emn-tag-key": "gameId"
        }
        },
        "required": [
        "gameId"
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:schemaDefinition id="GameQuestionEvent" name="GameQuestionEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameQuestionEvent",
        "allOf": [
        {
        "$ref": "GameEvent"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId",
        "x-emn-tag-key": "gameQuestionId"
        }
        },
        "required": [
        "gameQuestionId"
        ]
        }
        ]
        }</emn:schema>
    </emn:schemaDefinition>
    <emn:commandType id="EvaluateBuzzesCommand" name="EvaluateBuzzesCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "EvaluateBuzzesCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "windowId": {
        "type": "string",
        "format": "uuid"
        }
        },
        "required": [
        "gameQuestionId",
        "windowId"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CreateGameCommand" name="CreateGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CreateGameCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "name": {
        "type": "string"
        },
        "config": {
        "$ref": "GameConfig"
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        }
        },
        "required": [
        "name",
        "config",
        "creator",
        "moderator"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="JoinGameCommand" name="JoinGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "JoinGameCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "username": {
        "type": "string"
        }
        },
        "required": [
        "username"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="LeaveGameCommand" name="LeaveGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "LeaveGameCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "username": {
        "type": "string"
        }
        },
        "required": [
        "username"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="AbandonGameCommand" name="AbandonGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AbandonGameCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="StartGameCommand" name="StartGameCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "StartGameCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="StartNextRoundCommand" name="StartNextRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "StartNextRoundCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="ScoreRoundCommand" name="ScoreRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ScoreRoundCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CloseRoundCommand" name="CloseRoundCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CloseRoundCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="AnswerQuestionCommand" name="AnswerQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AnswerQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "username": {
        "type": "string"
        },
        "answer": {
        "type": "string"
        },
        "answerTimestamp": {
        "type": "string",
        "format": "date-time"
        }
        },
        "required": [
        "gameQuestionId",
        "username",
        "answer",
        "answerTimestamp"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="OverrideAnswerCommand" name="OverrideAnswerCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "OverrideAnswerCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "gamePlayerId": {
        "$ref": "GamePlayerId"
        },
        "answer": {
        "type": "string"
        }
        },
        "required": [
        "gameQuestionId",
        "gamePlayerId",
        "answer"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="BuzzQuestionCommand" name="BuzzQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "BuzzQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "username": {
        "type": "string"
        },
        "buzzerTimestamp": {
        "type": "string",
        "format": "date-time"
        }
        },
        "required": [
        "gameQuestionId",
        "username",
        "buzzerTimestamp"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="AnswerBuzzerQuestionCommand" name="AnswerBuzzerQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AnswerBuzzerQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        },
        "answerCorrect": {
        "type": "boolean"
        }
        },
        "required": [
        "gameQuestionId",
        "answerCorrect"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="AskNextQuestionCommand" name="AskNextQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "AskNextQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {}
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CloseQuestionCommand" name="CloseQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CloseQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameQuestionId"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="ExpireQuestionCommand" name="ExpireQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ExpireQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameQuestionId"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="CompleteQuestionIfReadyCommand" name="CompleteQuestionIfReadyCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "CompleteQuestionIfReadyCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameQuestionId"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:commandType id="ScoreQuestionCommand" name="ScoreQuestionCommand">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "ScoreQuestionCommand",
        "allOf": [
        {
        "$ref": "GameCommand"
        },
        {
        "type": "object",
        "properties": {
        "gameQuestionId": {
        "$ref": "GameQuestionId"
        }
        },
        "required": [
        "gameQuestionId"
        ]
        }
        ]
        }</emn:schema>
    </emn:commandType>
    <emn:eventType id="GameCreatedEvent" name="GameCreatedEvent">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="rounds" comment="Derived from questionSet" />
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "GameCreatedEvent",
        "allOf": [
        {
        "$ref": "GameEvent"
        },
        {
        "type": "object",
        "properties": {
        "name": {
        "type": "string"
        },
        "config": {
        "$ref": "GameConfig"
        },
        "rounds": {
        "type": "array",
        "items": {
        "$ref": "Round"
        }
        },
        "creator": {
        "type": "string"
        },
        "moderator": {
        "type": [
        "string",
        "null"
        ]
        }
        },
        "required": [
        "name",
        "config",
        "rounds",
        "creator",
        "moderator"
        ]
        }
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="PlayerJoinedGameEvent" name="PlayerJoinedGameEvent">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="gamePlayerId" comment="" />
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "PlayerJoinedGameEvent",
        "allOf": [
        {
        "$ref": "GameEvent"
        },
        {
        "type": "object",
        "properties": {
        "gamePlayerId": {
        "$ref": "GamePlayerId"
        },
        "username": {
        "type": "string"
        }
        },
        "required": [
        "gamePlayerId",
        "username"
        ]
        }
        ]
        }</emn:schema>
    </emn:eventType>
    <emn:eventType id="PlayerLeftGameEvent" name="PlayerLeftGameEvent">
      <emn:schema schemaFormat="application/schema+json">{
        "$id": "PlayerLeftGameEvent",
